# Keep the build context small and keep secrets out of the image.

.git
.gitignore
venv/
__pycache__/
**/__pycache__/
*.pyc

# Secrets: configuration is injected as environment variables at deploy time.
.env
.env.*
!.env.example

# Raw and intermediate data. Only the prebuilt FAISS index is copied in, and
# the Dockerfile names it explicitly.
data/01_raw/
data/02_intermediate/

frontend/
tests/
chatbot.log
*.md
