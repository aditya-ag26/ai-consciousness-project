# Copy to .env and adjust. Every value below has a working default, so the app
# runs locally without a .env file at all.

# --- API security -----------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API.
# Set this to your deployed frontend URL in production. Never use "*".
ALLOWED_ORIGINS=http://localhost:5173

# Per-IP request cap. Each chat request runs a local LLM for several seconds,
# so this is the main protection against accidental or deliberate overload.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Serves the interactive API docs at /docs. Set to false in production to avoid
# publishing the API surface.
ENABLE_DOCS=true

# --- Model backend ----------------------------------------------------------

# Which language model backend to use. Overrides rag_application.llm.provider
# in config/config.yaml.
#
#   ollama  - runs the model on this machine. No API key, nothing leaves the
#             host. Needs ~1GB RAM free. This is the default for development.
#   gemini  - calls a hosted model. Needs GOOGLE_API_KEY but barely any memory,
#             which is what makes free-tier container hosting practical.
#
# LLM_PROVIDER=ollama

# Where the Ollama server is reachable. Inside Docker Compose this becomes
# http://ollama:11434; on the host it is http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# Required only when LLM_PROVIDER=gemini. Create a key at
# https://aistudio.google.com/apikey - the API has its own free tier, separate
# from any consumer Gemini subscription.
# GOOGLE_API_KEY=your-api-key-here

# --- Optional ---------------------------------------------------------------

# Not used by either bundled provider. Kept because the LLM layer is pluggable
# (see src/rag_pipeline/llm_provider.py): if you add an OpenAI backend, its key
# belongs here.
# OPENAI_API_KEY=your-api-key-here
